---
import Base from "../layouts/Base.astro";
import RealRecording from "../components/RealRecording.astro";
import Testimonials from "../components/Testimonials.astro";
import MissedCalls from "../components/MissedCalls.astro";
import BookDemo from "../components/BookDemo.astro";
import VideoTestimonial from "../components/VideoTestimonial.astro";
import { RECORDINGS } from "../data/recordings";
import { TESTIMONIALS } from "../data/testimonials";

const jennyCalls = RECORDINGS.filter((r) => r.product === "jenny");
// Mandar Gokhale appears in the video card, so his written quote isn’t repeated below it.
const jennyQuotes = TESTIMONIALS.filter((t) => t.product === "jenny" && t.name !== "Mandar Gokhale");
---
<Base
  title="Jenny, AI Receptionist | JOBGEN.AI"
  description="Your next call. Handled. Jenny is the AI receptionist from the JOBGEN.AI AI workforce, for any business where the phone rarely stops."
  ogTitle="Your next call. Handled. Meet Jenny, the AI receptionist by JOBGEN.AI."
  ogDescription="For any business where the phone rarely stops. Jenny answers, captures what matters and hands your team a clean summary."
  ogImage="/og/jenny.png"
  ogImageAlt="Jenny by JOBGEN.AI: Your next call. Handled."
  bookHref="#book"
  bookBarText="Hear the real Jenny in 30 minutes"
>
      <!-- HERO -->
      <section class="hero" aria-labelledby="hero-title">
        <div class="aurora" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
        <div class="wrap hero-inner">
          <div class="product" aria-label="Jenny, AI receptionist, part of the JOBGEN.AI workforce">
            <span class="product-voice" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
            <span class="product-name">Jenny</span>
            <span class="product-sep" aria-hidden="true"></span>
            <span class="product-role">AI receptionist</span>
            <span class="product-sep product-wide" aria-hidden="true"></span>
            <span class="product-by product-wide mono"><b>JOBGEN.AI</b> workforce</span>
          </div>
          <h1 id="hero-title">
            <span class="h1-line">Your next<br class="br-mobile" />
              <span class="rotator" aria-hidden="true">
                <span class="is-active" style="--tint: var(--prop)">buyer</span>
                <span style="--tint: var(--edu)">booking</span>
                <span style="--tint: #b48cff">after-hours</span>
                <span style="--tint: var(--rest)">missed</span>
              </span><span class="sr-only">buyer, booking, after-hours or missed</span> call.</span>
            <span class="h1-line h1-muted">Handled.</span>
          </h1>
          <p class="hero-position">For any business where the phone rarely stops.</p>
          <p class="hero-sub">
            Jenny answers like your best front-desk person. She helps the caller, captures what matters and hands
            your team a clean summary.
          </p>
          <div class="hero-actions">
            <a class="btn btn-light" href="#book">Book a demo <span aria-hidden="true">→</span></a>
            <a class="btn btn-ghost" href="#try"><span class="ring-dot" aria-hidden="true"></span>Try a demo call</a>
          </div>
        </div>

        <canvas class="voice-ribbon" id="voice-ribbon" aria-hidden="true"></canvas>

        <div class="wrap">
          <div class="desk" aria-label="Example calls Jenny could handle">
            <p class="desk-label mono">EXAMPLES · OLIVIA ON SHIFT AT THE FRONT DESK</p>
            <div class="desk-grid">
              <article class="mini" style="--tint: var(--edu)" data-result="Campus tour booked">
                <header><span class="dot"></span>School</header>
                <strong>Year 7 enrolment</strong>
                <p class="mini-status"><span class="mini-wave"><i></i><i></i><i></i><i></i><i></i></span><span class="mini-text">Ringing</span></p>
              </article>
              <article class="mini" style="--tint: var(--prop)" data-result="Open home registered">
                <header><span class="dot"></span>Real estate</header>
                <strong>Buyer enquiry</strong>
                <p class="mini-status"><span class="mini-wave"><i></i><i></i><i></i><i></i><i></i></span><span class="mini-text">Ringing</span></p>
              </article>
              <article class="mini" style="--tint: var(--rest)" data-result="Table for 6 confirmed">
                <header><span class="dot"></span>Restaurant</header>
                <strong>Friday booking</strong>
                <p class="mini-status"><span class="mini-wave"><i></i><i></i><i></i><i></i><i></i></span><span class="mini-text">Ringing</span></p>
              </article>
              <article class="mini" style="--tint: var(--care)" data-result="Centre tour booked">
                <header><span class="dot"></span>Child care</header>
                <strong>New family</strong>
                <p class="mini-status"><span class="mini-wave"><i></i><i></i><i></i><i></i><i></i></span><span class="mini-text">Ringing</span></p>
              </article>
            </div>
          </div>
        </div>
      </section>

      <!-- TRY IT -->
      <section class="try" id="try" aria-labelledby="try-title">
        <div class="aurora aurora-soft" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
        <div class="wrap try-grid">
          <div class="try-copy">
            <p class="mono reveal">INTERACTIVE DEMO · SIMULATED CALL</p>
            <h2 id="try-title" class="reveal">Your turn.<br /><span class="grad">Call Jenny.</span></h2>
            <p class="section-sub reveal">Pick a business, press call and choose what the caller says. When you hang up, you’ll see the summary the team would get.</p>
            <div class="try-pick reveal" role="radiogroup" aria-label="Choose an example business to call">
              <button type="button" role="radio" aria-checked="true" tabindex="0" data-industry="education" style="--tint: var(--edu)"><span class="pick-dot"></span><b>Northside College</b><small>School</small></button>
              <button type="button" role="radio" aria-checked="false" tabindex="-1" data-industry="property" style="--tint: var(--prop)"><span class="pick-dot"></span><b>Harbour &amp; Co Realty</b><small>Real estate</small></button>
              <button type="button" role="radio" aria-checked="false" tabindex="-1" data-industry="restaurant" style="--tint: var(--rest)"><span class="pick-dot"></span><b>Luca’s Trattoria</b><small>Restaurant</small></button>
              <button type="button" role="radio" aria-checked="false" tabindex="-1" data-industry="childcare" style="--tint: var(--care)"><span class="pick-dot"></span><b>Little Acorns</b><small>Child care</small></button>
              <button type="button" role="radio" aria-checked="false" tabindex="-1" data-industry="trades" style="--tint: var(--trade)"><span class="pick-dot"></span><b>Kestrel Plumbing</b><small>Trades &amp; services</small></button>
            </div>
            <p class="try-note reveal">Fictional businesses, scripted examples. Jenny is set up around your own calls, whatever your business.</p>
            <button type="button" class="listen-btn reveal" id="listen-btn"><span class="listen-icon" aria-hidden="true"></span><span id="listen-label">Or just listen to a full example call</span></button>
            <label class="voice-toggle reveal"><input type="checkbox" id="voice" role="switch" checked /><i></i><span>Read the call aloud<small>Uses your device’s built-in voice, not Jenny’s. <a href="#proof">Hear her real voice ↓</a></small></span></label>
          </div>

          <div class="try-stage reveal">
            <div class="phone" id="phone" data-state="idle">
              <div class="phone-island" aria-hidden="true"></div>
              <div class="phone-head">
                <span class="phone-tag mono">SIMULATED CALL</span>
                <span class="phone-orb" aria-hidden="true"><i></i><i></i></span>
                <strong id="phone-name">Northside College</strong>
                <span id="phone-status">On shift · ready when you are</span>
              </div>
              <div class="phone-body" id="phone-body" aria-live="polite">
                <p class="phone-hint">Press the green button to ring Jenny, or just listen to a full example call.</p>
              </div>
              <div class="phone-replies" id="phone-replies" role="group" aria-label="Choose what to say"></div>
              <div class="phone-actions">
                <button class="call-btn" id="call-btn" aria-label="Call Northside College">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.6a1 1 0 0 1-.25 1z" /></svg>
                </button>
              </div>
            </div>
            <aside class="inbox" aria-label="Team inbox preview">
              <p class="mono">TEAM INBOX · PREVIEW</p>
              <div class="inbox-list" id="inbox-list" aria-live="polite">
                <p class="inbox-empty">After the call, you’ll see the summary your team would receive. This demo doesn’t send anything.</p>
              </div>
              <div class="inbox-cta" id="inbox-cta" hidden>
                <p>That’s one call handled. See how Jenny would handle yours.</p>
                <a class="btn btn-light btn-small" href="#book">Book a demo <span aria-hidden="true">→</span></a>
              </div>
            </aside>
          </div>
        </div>
      </section>


      <!-- REAL CALLS + CUSTOMERS -->
      <section class="proof light" id="proof" aria-labelledby="proof-title">
        <div class="wrap">
          <div class="section-head">
            <p class="mono reveal">REAL CALLS · REAL CUSTOMERS</p>
            <h2 id="proof-title" class="reveal">Hear the real Jenny.</h2>
            <p class="section-sub reveal">A real call Jenny answered for McGill Institute, and what the businesses she works for say about her.</p>
          </div>
          <div class="proof-recordings">
            {jennyCalls.map((rec) => <RealRecording rec={rec} aiLabel="Jenny" />)}
          </div>
          <div class="listen-live reveal">
            <p><b>Rather try a call yourself?</b> Have a short live reception call in your browser. Microphone required · Up to 2 minutes · No account needed.</p>
            <a class="btn btn-ink" href="/demo/" data-live-demo="receptionist">Try a live call <span aria-hidden="true">→</span></a>
            <span class="listen-live-status" data-live-demo-status aria-live="polite"></span>
          </div>
          <VideoTestimonial />
          <Testimonials items={jennyQuotes} />
        </div>
      </section>

      <!-- RULES -->
      <section class="rules" id="rules" aria-labelledby="rules-title">
        <div class="wrap rules-grid">
          <div>
            <p class="mono reveal">YOUR BUSINESS. YOUR RULES.</p>
            <h2 id="rules-title" class="reveal">Set the boundaries.<br /><span class="muted">Keep the context.</span></h2>
            <p class="section-sub reveal">
              Brief her like any new team member. You decide what Jenny answers, what she collects and when a person takes over. Try a few settings.
            </p>
          </div>
          <div class="console reveal" aria-label="Example settings for Jenny">
            <label class="rule"><span><b>Answer common questions</b><small>Hours, fees, availability</small></span><input type="checkbox" role="switch" data-rule="answer common questions" checked /><i></i></label>
            <label class="rule"><span><b>Take booking requests</b><small>Tours, inspections, tables</small></span><input type="checkbox" role="switch" data-rule="take booking requests" checked /><i></i></label>
            <label class="rule"><span><b>Escalate urgent calls</b><small>Straight to your on-call person</small></span><input type="checkbox" role="switch" data-rule="send urgent calls to a person" checked /><i></i></label>
            <label class="rule"><span><b>After-hours mode</b><small>Set expectations for follow-up</small></span><input type="checkbox" role="switch" data-rule="tell after-hours callers when you’ll follow up" /><i></i></label>
            <p class="console-out" aria-live="polite"><span class="mono">OLIVIA WILL</span><span id="rule-summary"></span></p>
          </div>
        </div>
      </section>

      <!-- SETUP -->
      <section class="setup light" id="setup" aria-labelledby="setup-title">
        <div class="wrap">
          <div class="section-head">
            <p class="mono reveal">ONBOARDING</p>
            <h2 id="setup-title" class="reveal">Onboard Jenny in three steps.</h2>
            <p class="section-sub reveal">We do the setting up with you, and nothing goes live until you’re happy with how Jenny sounds.</p>
          </div>
          <ol class="steps">
            <li class="step reveal">
              <span class="step-no">1</span>
              <h3>Tell us about your calls.</h3>
              <p>In a 30-minute demo, walk us through your busiest calls and what a great answer sounds like.</p>
              <span class="step-tag mono">30 MIN DEMO</span>
            </li>
            <li class="step reveal">
              <span class="step-no">2</span>
              <h3>We onboard Jenny.</h3>
              <p>Your information, questions and handoff rules go in. You hear how she answers before anything goes live.</p>
              <span class="step-tag mono">YOU APPROVE</span>
            </li>
            <li class="step reveal">
              <span class="step-no">3</span>
              <h3>Go live and fine-tune.</h3>
              <p>Calls are answered, summaries reach your team, and you adjust the rules whenever your business changes.</p>
              <span class="step-tag mono">ALWAYS ADJUSTABLE</span>
            </li>
          </ol>
        </div>
      </section>

      <!-- MISSED-CALL CALCULATOR: the visitor's own numbers -->
      <MissedCalls />


      <!-- FAQ -->
      <section class="faq light" id="faq" aria-labelledby="faq-title">
        <div class="wrap faq-grid">
          <div>
            <p class="mono reveal">QUESTIONS</p>
            <h2 id="faq-title" class="reveal">Good questions.<br /><span class="muted">Straight answers.</span></h2>
          </div>
          <div class="faq-list reveal">
            <details open>
              <summary>Will callers know they’re speaking with AI?</summary>
              <p>Yes. Jenny introduces herself as an AI assistant at the start of the call, so callers always know who they’re talking to.</p>
            </details>
            <details>
              <summary>What happens if Jenny doesn’t know the answer?</summary>
              <p>She doesn’t guess. She takes the caller’s details and passes the question to the right person on your team, following your handoff rules.</p>
            </details>
            <details>
              <summary>Can a call go to a real person?</summary>
              <p>Yes. Your rules decide when a person takes over and who that person is, for example urgent matters, complaints or specific requests.</p>
            </details>
            <details>
              <summary>What does my team receive after each call?</summary>
              <p>A short summary: who called, what they needed, what was captured or booked, and who should follow up.</p>
            </details>
            <details>
              <summary>How is call information protected?</summary>
              <p>Call information is handled under JOBGEN.AI’s <a href="https://jobgen.ai/privacy/">privacy policy</a>. We’re happy to walk through the details in your demo.</p>
            </details>
            <details>
              <summary>What is JOBGEN.AI?</summary>
              <p>JOBGEN.AI builds an AI workforce for busy businesses: AI team members that take on everyday work so your people can focus on what needs them. Jenny, the AI receptionist, looks after your phones.</p>
            </details>
            <details>
              <summary>Which businesses is Jenny for?</summary>
              <p>Any business where the phone rarely stops. The schools, agencies, restaurants, childcare centres and trades on this page are examples; Jenny is set up around your own calls and rules.</p>
            </details>
            <details>
              <summary>How long does setup take?</summary>
              <p>A straightforward deployment can be live within a few business days. JobGen.AI configures the voice, scripts, calendar connections and handover rules with the business, then runs a test period before handling live calls.</p>
            </details>
            <details>
              <summary>What does Jenny cost?</summary>
              <p>Pricing depends on the expected call volume and setup. You can <a href="/pricing/">estimate the price per conversation</a>, and we’ll give you pricing for your usage in the demo.</p>
            </details>
            <details>
              <summary>Is the voice in the demo Jenny’s real voice?</summary>
              <p>No. The interactive demo is a simulated call that uses your device’s built-in voice so you can try it instantly. To hear Jenny herself, play the real recorded call on this page, or book a demo.</p>
            </details>
          </div>
        </div>
      </section>

      <!-- BOOK -->
      <BookDemo
        eyebrow="30 MINUTES · YOUR BUSINESS, YOUR CALLS"
        line1="Give your next call"
        line2="a better ending."
        sub="Pick a time and hear Jenny on a live call."
        agenda={[{ title: "Hear Jenny live" }, { title: "Map your calls and handovers" }, { title: "Setup and pricing" }]}
        quoteFrom="McGill Institute"
      />


  <Fragment slot="scripts">
    <script is:inline src="/js/calls.js"></script>
    <script is:inline src="/js/tryit.js"></script>
  </Fragment>
</Base>
