---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import RealRecording from "../components/RealRecording.astro";
import Testimonials from "../components/Testimonials.astro";
import BookDemo from "../components/BookDemo.astro";
import LogoStrip from "../components/LogoStrip.astro";
import VideoTestimonial from "../components/VideoTestimonial.astro";
import Faq from "../components/Faq.astro";
import { WORKFORCE, LINKS } from "../data/site";
import { RECORDINGS } from "../data/recordings";
import { TESTIMONIALS } from "../data/testimonials";
import { FOUNDER } from "../data/founder";

// Kush's card only shows once he has approved the words and a photo is added.
const founderLive = FOUNDER.approved && FOUNDER.photo !== "";

// One real call per product that has one.
const calls = [
  RECORDINGS.find((r) => r.id === "education-support"),
  RECORDINGS.find((r) => r.id === "property-report"),
].filter((r) => r !== undefined);
const labels: Record<string, string> = { jenny: "Jenny", olivia: "Olivia" };
// After the featured story: one more customer per professional, word for word.
const quotes = ["George Limberis", "Buta Deogun", "Pri Gillett"]
  .map((n) => TESTIMONIALS.find((t) => t.name === n))
  .filter((t) => t !== undefined);

// Featured story: every line comes from Mandar's published testimonial, nothing added.
const STORY: [string, string][] = [
  ["THE PROBLEM", "Phone calls kept interrupting the team’s work."],
  ["WHAT WE IMPLEMENTED", "Jenny, an AI receptionist, taking the firm’s calls."],
  ["WHAT CHANGED", "Jenny handles what she can and passes on only the calls that need a person."],
];

// Solutions, organised by the problem a business owner would name. Descriptions stay to what each
// service does (sources: jobgen.ai, sales.jobgen.ai and JobGen's own brief), with their limits.
const SOLUTIONS = [
  {
    problem: "Calls go unanswered when you’re busy or closed",
    name: "AI receptionist",
    who: "Jenny",
    tint: "var(--edu)",
    text: "Handles incoming calls around the clock: answers approved questions, takes messages and books appointments, with handover to your team when needed.",
    links: [{ label: "Meet Jenny", href: "/receptionist/" }, { label: "Estimate what missed calls are worth", href: "/receptionist/#cost" }],
  },
  {
    problem: "Bookings and reschedules take up your team’s day",
    name: "Appointment management",
    who: "Jenny",
    tint: "#b48cff",
    text: "Books, moves, cancels and confirms appointments in connected calendars, so fewer booking calls land on your team.",
    links: [{ label: "See appointment booking", href: "/solutions/booking/" }],
  },
  {
    problem: "Enquiries go cold before anyone follows up",
    name: "Lead follow-up workflows",
    tint: "var(--prop)",
    text: "Automate SMS and email follow-up for the enquiries you choose, with each lead kept in a built-in CRM so your team can see where it stands.",
    links: [],
  },
  {
    problem: "Owners on your database never hear from you",
    name: "AI sales agent for real estate",
    who: "Olivia",
    tint: "var(--prop)",
    text: "Calls known property owners, listens for selling intent and arranges appraisals or agent callbacks. Respects do-not-contact preferences.",
    links: [{ label: "Meet Olivia", href: "/olivia/" }],
  },
  {
    problem: "More applicants than time to screen them",
    name: "AI recruitment assistant",
    who: "Jess",
    tint: "var(--care)",
    text: "Screens applicants by phone, scores their responses and writes results back to supported ATSs (Bullhorn, JobDiva, Ceipal).",
    links: [{ label: "Meet Jess", href: "/recruiter-agent/" }],
  },
  {
    problem: "Your website doesn’t turn visitors into enquiries",
    name: "AI-ready website and chat",
    tint: "var(--rest)",
    text: "A website built to convert, with a chat assistant and offers such as evaluation reports or guides to capture enquiries.",
    links: [{ label: "See web development", href: LINKS.webDevelopment }],
  },
];

// How an implementation runs. Wording from the published setup answer and Jenny's onboarding steps.
const PROCESS = [
  { title: "We look at where AI can help", text: "On a 30-minute call, walk us through your calls, enquiries and admin. We suggest where to start." },
  { title: "We build and connect it", text: "We set up the information, questions, calendar connections and handover rules with you. Channels, CRM connections and live transfers depend on your setup." },
  { title: "You test it before it goes live", text: "We run a test period before it handles live calls. A straightforward deployment can be live within a few business days." },
  { title: "We adjust it as you go", text: "Summaries and transcripts reach your team, and the rules can change whenever your business does." },
];
---
<Base
  title="Grow your business with an AI workforce | JOBGEN.AI"
  description="We identify where AI can help your business, then build and connect the right solution: answering calls, managing appointments and following up enquiries."
  ogTitle="Grow your business with an AI workforce. JOBGEN.AI"
  ogDescription="We identify where AI can help your business, then build and connect the right solution. Start with one."
  ogImage="/og/home.png"
  ogImageAlt="JOBGEN.AI: Grow your business with an AI workforce."
>
  <PageHero
    eyebrow="WE AUTOMATE WORK, NOT REPLACE PEOPLE"
    sub="We identify where AI can help your business, then build and connect the right solution: from answering calls and managing appointments to following up enquiries."
    secondary={{ label: "Hear a real call ↓", href: "#listen" }}
  >
    <span class="h1-line">Grow your business</span>
    <span class="h1-line h1-muted">with an AI workforce.</span>
    <p slot="under" class="hero-reassure"><span class="hero-reassure-dot" aria-hidden="true"></span>Start with one solution. We build and connect what your business needs.</p>
    <div slot="below" class="wrap hero-team">
      <ul class="team-strip" aria-label="Your AI workforce">
        {WORKFORCE.map((w) => (
          <li style={`--tint: ${w.tint}`}>
            <a href={w.href}>
              <span class="team-voice" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
              <span><b>{w.name}</b><small>{w.role}</small></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </PageHero>

  <LogoStrip />

  <!-- 01 · HEAR A REAL CALL -->
  <section class="chapter proof listen light" id="listen" aria-labelledby="listen-title">
    <div class="wrap">
      <div class="section-head">
        <p class="mono chapter-no reveal">01 · HEAR A REAL CALL</p>
        <h2 id="listen-title" class="reveal">Don’t take our word for it.<br /><span class="muted">Listen.</span></h2>
        <p class="section-sub reveal">Real calls from real businesses, with personal details removed.</p>
      </div>
      <div class="proof-recordings home-calls">
        {calls.map((rec) => <RealRecording rec={rec} aiLabel={labels[rec.product ?? ""] ?? "AI"} />)}
      </div>
      <div class="listen-live reveal">
        <p><b>Rather talk to one yourself?</b> Try a short live conversation in your browser. Microphone required · Up to 2 minutes · No account needed.</p>
        <a class="btn btn-ink" href="/demo/" data-live-demo="receptionist">Try a live demo <span aria-hidden="true">→</span></a>
        <span class="listen-live-status" data-live-demo-status aria-live="polite"></span>
      </div>
    </div>
  </section>

  <!-- 02 · FEATURED CUSTOMER STORY -->
  <section class="chapter proof story-section light" id="proof" aria-labelledby="proof-title">
    <div class="wrap">
      <div class="section-head">
        <p class="mono chapter-no reveal">02 · CUSTOMER STORY · M&amp;S BUSINESS SOLUTIONS</p>
        <h2 id="proof-title" class="reveal">An accounting firm<br /><span class="muted">gets back to the work.</span></h2>
      </div>
      <VideoTestimonial heading="The phone stopped interrupting the work." story={STORY} storyNote="Summarised from Mandar’s own words, below and in the video." />
      <p class="more-quotes mono reveal">MORE FROM OUR CUSTOMERS</p>
      <Testimonials items={quotes} />
    </div>
  </section>

  <!-- 03 · SOLUTIONS BY PROBLEM -->
  <section class="chapter fixes light" id="solutions" aria-labelledby="solutions-title">
    <div class="wrap">
      <div class="section-head">
        <p class="mono chapter-no reveal">03 · WHAT WE BUILD</p>
        <h2 id="solutions-title" class="reveal">Start with the problem<br /><span class="muted">costing you most.</span></h2>
        <p class="section-sub reveal">Pick one to start. We build it, connect it to the tools you already use and add more only when it’s working.</p>
      </div>
      <ul class="fix-grid">
        {SOLUTIONS.map((x, i) => (
          <li class="fix reveal" style={`--tint: ${x.tint}; transition-delay: ${(i % 3) * 60}ms`}>
            <p class="fix-problem mono">{x.problem}</p>
            <h3>{x.name}{x.who && <span class="fix-who">· {x.who}</span>}</h3>
            <p class="fix-text">{x.text}</p>
            {x.links.length > 0 && (
              <p class="fix-links">
                {x.links.map((l) => <a href={l.href}>{l.label} <span aria-hidden="true">→</span></a>)}
              </p>
            )}
          </li>
        ))}
      </ul>
      <div class="fix-more reveal">
        <p><b>Need it connected to something specific?</b> We build custom integrations with the systems your industry relies on, such as booking systems, real estate portals and council planning data.</p>
        <button type="button" class="btn btn-ink" data-guide-open-alt>Not sure where to start? <span aria-hidden="true">→</span></button>
      </div>
    </div>
  </section>

  <!-- 04 · HOW WE WORK WITH YOU -->
  <section class="chapter how-we-work" id="process" aria-labelledby="process-title">
    <div class="aurora aurora-soft" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
    <div class="wrap">
      <div class="section-head">
        <p class="mono chapter-no reveal">04 · HOW WE WORK WITH YOU</p>
        <h2 id="process-title" class="reveal">We set it up with you.<br /><span class="grad">Your people stay in charge.</span></h2>
      </div>
      <div class="process-grid">
        <ol class="process-steps">
          {PROCESS.map((p, i) => (
            <li class="reveal" style={`transition-delay: ${i * 60}ms`}>
              <span class="process-no mono">{String(i + 1).padStart(2, "0")}</span>
              <div>
                <h3>{p.title}</h3>
                <p>{p.text}</p>
              </div>
            </li>
          ))}
        </ol>
        <div class="process-side">
          <div class="handover reveal">
            <p class="mono">A PERSON WHEN IT MATTERS</p>
            <h3>Human handover, built in.</h3>
            <p>When the AI can’t answer, it escalates instead of guessing. Depending on your rules it can live-transfer the caller, take a message or create a callback, with the transcript, summary and details passed to your team.</p>
            <p>You decide what it answers, what it collects and who takes over.</p>
          </div>
          {founderLive && (
            <figure class="founder-mini reveal">
              <img src={FOUNDER.photo} alt={FOUNDER.photoAlt} width="720" height="900" loading="lazy" />
              <figcaption>
                <p class="mono">THE PEOPLE BEHIND IT</p>
                <p class="founder-mini-text">JobGen.AI was founded in Sydney in 2024 by <b>{FOUNDER.name}</b>, our founder and CEO. Book a demo and you’ll talk it through with our team.</p>
                <a class="founder-more" href="/about/#story">Read our story <span aria-hidden="true">→</span></a>
              </figcaption>
            </figure>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- 05 · PLAIN ANSWERS -->
  <Faq eyebrow="05 · PLAIN ANSWERS" />

  <BookDemo
    eyebrow="30 MINUTES · SYDNEY AND SAN FRANCISCO"
    line1="Find where AI fits"
    line2="your business."
    sub="Pick a time. We’ll look at your calls, enquiries and admin, and suggest where to start."
    agenda={[{ title: "Where AI can help" }, { title: "Hear it live" }, { title: "Setup and pricing" }]}
  />

</Base>
