---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import RealRecording from "../components/RealRecording.astro";
import Testimonials from "../components/Testimonials.astro";
import BookDemo from "../components/BookDemo.astro";
import MissedCalls from "../components/MissedCalls.astro";
import LogoStrip from "../components/LogoStrip.astro";
import VideoTestimonial from "../components/VideoTestimonial.astro";
import HowItWorks from "../components/HowItWorks.astro";
import Faq from "../components/Faq.astro";
import { WORKFORCE } from "../data/site";
import { RECORDINGS } from "../data/recordings";
import { TESTIMONIALS } from "../data/testimonials";
import { FOUNDER } from "../data/founder";

// The founder card only shows once Kush has approved the words and a photo is added.
const founderLive = FOUNDER.approved && FOUNDER.photo !== "";

// One real call per product that has one, and one voice per product from the testimonials.
const calls = [
  RECORDINGS.find((r) => r.id === "education-support"),
  RECORDINGS.find((r) => r.id === "property-report"),
].filter((r) => r !== undefined);
const labels: Record<string, string> = { jenny: "Jenny", olivia: "Olivia" };
const quotes = ["George Limberis", "Buta Deogun", "Pri Gillett", "McGill Institute"]
  .map((n) => TESTIMONIALS.find((t) => t.name === n))
  .filter((t) => t !== undefined);

// Example activity for each professional's card in "Meet the team" (illustrative, labelled as such).
const LIVE: Record<string, string[]> = {
  jenny: ["Answered at 9:42pm · tour booked for Sat 10am", "Took a message · callback set for 8am", "Transferred to a person · urgent request"],
  olivia: ["Owner in Ryde · property report sent", "Owner in Castle Hill · appraisal booked", "Owner in Epping · not selling, noted"],
  jess: ["Payroll officer · 92% match · shortlisted", "Written to your ATS · interview booked", "Bookkeeper · kept on file for later"],
};

// Each problem card plays a small before → after (illustrative): what slips through today, then the same
// work handled.
const SCENES: Record<string, [string, string][]> = {
  jenny: [["Missed call · 6:04pm", "Answered · enquiry logged"], ["Missed call · 7:15pm", "Answered · booked for Tue 9am"], ["Voicemail · 9:48pm", "Answered · message passed on"]],
  olivia: [["Owner · last spoke months ago", "Called · report requested"], ["Owner · no reply yet", "Called · appraisal booked"], ["Owner · still on the list", "Called · not selling, noted"]],
  jess: [["Applicant · waiting since Monday", "Screened · shortlisted"], ["Applicant · not read yet", "Screened · interview booked"], ["Applicant · not read yet", "Screened · kept on file"]],
};
// The complete digital workforce, in the order a lead meets it (from JobGen's own positioning).
const ICON = (d: string) => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">${d}</svg>`;
const STACK = [
  { title: "AI-ready website", role: "The front door, built to convert", tint: "var(--edu)", icon: ICON('<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M7 6.5h.01M10 6.5h.01"/>'), points: ["Designed to turn visitors into enquiries", "Chat, booking and offers built in"], link: { label: "Web development", href: "/web-development/" } },
  { title: "AI chat and voice agents", role: "Your always-on team", tint: "#b48cff", icon: ICON('<path d="M4 10v4M8 7v10M12 4v16M16 8v8M20 11v2"/>'), points: ["Answer inbound calls and chats", "Make outbound calls", "Book straight into the diary"], link: { label: "Meet Jenny, Olivia and Jess", href: "#team" } },
  { title: "Lead magnets and offers", role: "Turn visitors into captured leads", tint: "var(--rest)", icon: ICON('<path d="M6 3h9l3 3v15H6z"/><path d="M14 3v4h4M9 12h6M9 16h4"/>'), points: ["Referral campaigns", "Evaluation reports", "Renovation guides and more"] },
  { title: "Built-in CRM, SMS and email", role: "Every lead followed up, automatically", tint: "var(--prop)", icon: ICON('<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>'), points: ["Every lead in one place", "SMS and email campaigns that chase for you"] },
  { title: "Custom integrations", role: "The data your industry runs on", tint: "var(--care)", icon: ICON('<path d="M9 7H6a3 3 0 0 0 0 6h3M15 7h3a3 3 0 0 1 0 6h-3M8 10h8"/><path d="M12 15v5M9 20h6"/>'), points: ["Council planning data", "Real estate portals", "Booking systems"] },
];
// Point solutions vs the complete workforce (generic: no competitor named).
const COMPARE: [string, string, string][] = [
  ["Website", "Separate supplier", "AI-ready website, built to convert"],
  ["Inbound and outbound calls", "Often, on its own", "Voice agents that book into your diary"],
  ["Chat", "Sometimes", "Chat agents on your site"],
  ["Lead magnets and offers", "Not included", "Referral campaigns, reports and guides"],
  ["CRM, SMS and email follow-up", "Another tool to buy", "Built in: every lead followed up"],
  ["Industry data and systems", "Do it yourself", "Custom integrations"],
  ["Who joins it all up", "You", "We do"],
  ["What you’re buying", "A tool", "The outcome: leads in, bookings made, admin gone"],
];
const problems = WORKFORCE.map((w) => ({ ...w, label: `${w.name} · ${w.role}`, scene: SCENES[w.key] ?? [] }));
---
<Base
  title="A complete AI workforce for your business | JOBGEN.AI"
  description="An AI-ready website, chat and voice agents that book into your diary, lead magnets, a built-in CRM with SMS and email follow-up, and custom integrations. Leads in, bookings made, admin gone."
  ogTitle="Grow your business with an AI workforce. JOBGEN.AI"
  ogDescription="AI professionals that answer your calls, book appointments, win new business and recruit talent, 24/7."
  ogImage="/og/home.png"
  ogImageAlt="JOBGEN.AI: Grow your business with an AI workforce."
>
  <PageHero
    eyebrow="WE AUTOMATE WORK, NOT REPLACE PEOPLE"
    sub="Not another AI tool. We deploy a complete digital workforce: an AI-ready website, chat and voice agents that book straight into your diary, lead capture, and a CRM that follows up every lead."
    secondary={{ label: "Hear a real call ↓", href: "#listen" }}
  >
    <span class="h1-line">Grow your business</span>
    <span class="h1-line h1-muted">with an AI workforce.</span>
    <div slot="below" class="wrap hero-team">
      <ul class="team-strip" aria-label="Your AI workforce">
        {WORKFORCE.map((w) => (
          <li style={`--tint: ${w.tint}`}>
            <a href={w.href}>
              <span class="team-voice" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
              <span><b>{w.name}</b><small>{w.role}</small></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </PageHero>

  <LogoStrip />

  <!-- 01 · HEAR A REAL CALL -->
  <section class="chapter proof listen light" id="listen" aria-labelledby="listen-title">
    <div class="wrap">
      <div class="section-head">
        <p class="mono chapter-no reveal">01 · HEAR A REAL CALL</p>
        <h2 id="listen-title" class="reveal">Don’t take our word for it.<br /><span class="muted">Listen.</span></h2>
        <p class="section-sub reveal">Real calls from real businesses, with personal details removed.</p>
      </div>
      <div class="proof-recordings home-calls">
        {calls.map((rec) => <RealRecording rec={rec} aiLabel={labels[rec.product ?? ""] ?? "AI"} />)}
      </div>
      <div class="listen-live reveal">
        <p><b>Rather talk to one yourself?</b> Try a short live conversation in your browser. Microphone required · Up to 2 minutes · No account needed.</p>
        <a class="btn btn-ink" href="/demo/" data-live-demo="receptionist">Try a live demo <span aria-hidden="true">→</span></a>
        <span class="listen-live-status" data-live-demo-status aria-live="polite"></span>
      </div>
    </div>
  </section>

  <!-- 02 · THE PROBLEM -->
  <section class="chapter problem light" id="problem" aria-labelledby="problem-title">
    <div class="wrap">
      <div class="section-head">
        <p class="mono chapter-no reveal">02 · THE PROBLEM</p>
        <h2 id="problem-title" class="reveal">Revenue leaks<br /><span class="muted">in two places.</span></h2>
        <p class="section-sub reveal">
          Most small businesses can’t afford to hire for either. And generic AI tools leave you to stitch everything
          together yourself.
        </p>
      </div>
      <div class="leaks">
        <article class="leak reveal">
          <span class="leak-no mono">LEAK 1</span>
          <h3>Leads that never get followed up</h3>
          <ul>
            <li>Missed calls</li>
            <li>Slow replies</li>
            <li>Forms nobody chases</li>
          </ul>
        </article>
        <article class="leak reveal" style="transition-delay: 80ms">
          <span class="leak-no mono">LEAK 2</span>
          <h3>Staff time swallowed by admin</h3>
          <ul>
            <li>Bookings and reception</li>
            <li>Data entry</li>
            <li>Follow-up campaigns</li>
          </ul>
        </article>
      </div>
      <p class="picker-lead mono reveal">WHERE IT SHOWS UP FIRST</p>
      <ul class="picker picker-3">
        {problems.map((p, i) => (
          <li class="reveal" style={`--tint: ${p.tint}; transition-delay: ${i * 60}ms`}>
            <a href={p.href}>
              <span class="picker-problem mono">{p.problem}</span>
              <strong>{p.promise}</strong>
              <span class="picker-scene" data-scene aria-hidden="true">
                {p.scene.map(([before, after], k) => (
                  <span class="scene-row" style={`--k: ${k}`}>
                    <span class="scene-before"><i></i>{before}</span>
                    <span class="scene-after"><i></i>{after}</span>
                  </span>
                ))}
              </span>
              <span class="picker-who"><span class="dot"></span>{p.label}<span class="arrow" aria-hidden="true">→</span></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 03 · THE SOLUTION -->
  <section class="chapter stack-section" id="solution" aria-labelledby="solution-title">
    <div class="aurora aurora-soft" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
    <div class="wrap">
      <div class="section-head">
        <p class="mono chapter-no reveal">03 · THE SOLUTION</p>
        <h2 id="solution-title" class="reveal">Not a single tool.<br /><span class="grad">A complete digital workforce.</span></h2>
        <p class="section-sub reveal">We deploy every piece into your business and join it up, so each lead is caught, followed up and booked.</p>
      </div>
      <ol class="stack">
        {STACK.map((item, i) => (
          <li class="stack-item reveal" style={`--tint: ${item.tint}; transition-delay: ${i * 60}ms`}>
            <span class="stack-no mono">{String(i + 1).padStart(2, "0")}</span>
            <span class="stack-icon" aria-hidden="true" set:html={item.icon}></span>
            <h3>{item.title}</h3>
            <p class="stack-role">{item.role}</p>
            <ul>
              {item.points.map((pt) => <li>{pt}</li>)}
            </ul>
            {item.link && <a class="stack-link" href={item.link.href}>{item.link.label} <span aria-hidden="true">→</span></a>}
          </li>
        ))}
      </ol>
      <ol class="flow reveal" aria-label="What it adds up to">
        <li><b>Leads in</b><span>Website, offers and agents catch every enquiry</span></li>
        <li><b>Followed up</b><span>CRM, SMS and email chase every lead</span></li>
        <li><b>Bookings made</b><span>Straight into your diary</span></li>
        <li><b>Admin gone</b><span>Reception, data entry and campaigns handled</span></li>
      </ol>
    </div>
  </section>

  <!-- 04 · WHY JOBGEN -->
  <section class="chapter why light" id="why" aria-labelledby="why-title">
    <div class="wrap">
      <div class="section-head">
        <p class="mono chapter-no reveal">04 · WHY JOBGEN.AI</p>
        <h2 id="why-title" class="reveal">Others sell a piece.<br /><span class="muted">We deliver the outcome.</span></h2>
        <p class="section-sub reveal">Most providers sell a point solution: a voice bot, or a website. We take the whole job, end to end.</p>
      </div>
      <div class="compare reveal" role="region" aria-label="Point solutions compared with JobGen.AI" tabindex="0">
        <table>
          <thead>
            <tr>
              <th scope="col"><span class="sr-only">What you need</span></th>
              <th scope="col">A point solution</th>
              <th scope="col" class="compare-us">JOBGEN.AI</th>
            </tr>
          </thead>
          <tbody>
            {COMPARE.map(([need, them, us]) => (
              <tr>
                <th scope="row">{need}</th>
                <td data-label="A point solution">{them}</td>
                <td class="compare-us" data-label="JOBGEN.AI"><span class="tick" aria-hidden="true">✓</span>{us}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="why-cta reveal">
        <a class="btn btn-ink" href="#book">Book a demo <span aria-hidden="true">→</span></a>
        <span>See the whole workforce working for your business in 30 minutes.</span>
      </div>
    </div>
  </section>

  <!-- 05 · THE COST OF A MISSED CALL -->
  <MissedCalls eyebrow="05 · THE COST OF A MISSED CALL" />

  <!-- 06 · MEET THE TEAM -->
  <section class="chapter team" id="team" aria-labelledby="team-title">
    <div class="aurora aurora-soft" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
    <div class="wrap">
      <div class="section-head">
        <p class="mono chapter-no reveal">06 · MEET THE TEAM</p>
        <h2 id="team-title" class="reveal">Specialists,<br /><span class="grad">not one chatbot.</span></h2>
        <p class="section-sub reveal">
          Every JobGen.AI professional does one job and does it well. Pick the one that fits the work.
        </p>
      </div>
      <div class="team-grid">
        {WORKFORCE.map((w, i) => (
          <article class="member reveal" style={`--tint: ${w.tint}; transition-delay: ${i * 80}ms`}>
            <header>
              <span class="member-voice" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
              <div>
                <h3>{w.name}</h3>
                <p class="mono">{w.role}</p>
              </div>
            </header>
            <p class="member-summary">{w.summary}</p>
            <p class="member-live" data-live={JSON.stringify(LIVE[w.key] ?? [])}>
              <span class="member-live-dot" aria-hidden="true"></span>
              <span class="member-live-text">{LIVE[w.key]?.[0]}</span>
              <small>example</small>
            </p>
            <ul>
              {w.capabilities.map((c) => <li>{c}</li>)}
            </ul>
            <a class="member-link" href={w.href}>Meet {w.name} <span aria-hidden="true">→</span></a>
          </article>
        ))}
      </div>
    </div>
  </section>


  <!-- 07 · WHAT CUSTOMERS SAY -->
  <section class="chapter proof light" id="proof" aria-labelledby="proof-title">
    <div class="wrap">
      <div class="section-head">
        <p class="mono chapter-no reveal">07 · WHAT CUSTOMERS SAY</p>
        <h2 id="proof-title" class="reveal">Calls answered.<br /><span class="muted">Teams back on the work.</span></h2>
      </div>
      <VideoTestimonial />
      <Testimonials items={quotes} />
    </div>
  </section>

  <!-- 08 · HOW IT WORKS -->
  <HowItWorks eyebrow="08 · HOW IT WORKS" />

  <!-- 09 · WITH YOUR PEOPLE -->
  <section class="chapter people" aria-labelledby="people-title">
    <div class="wrap people-grid">
      <div>
        <p class="mono chapter-no reveal">09 · WITH YOUR PEOPLE</p>
        <h2 id="people-title" class="reveal">We automate work,<br /><span class="muted">not replace people.</span></h2>
        <p class="section-sub reveal">
          Your AI workforce handles the repetitive, round-the-clock work, so your team spends its day on the
          conversations only people can have.
        </p>
      </div>
      <ol class="principles">
        <li class="reveal">
          <span class="mono">A PERSON WHEN IT MATTERS</span>
          <h3>Human escalation, built in.</h3>
          <p>They transfer the call, take a message or arrange a callback whenever a person is needed.</p>
        </li>
        <li class="reveal">
          <span class="mono">YOUR RULES</span>
          <h3>You decide what they handle.</h3>
          <p>What they answer, what they collect and who takes over is set by you, and you can change it any time.</p>
        </li>
        <li class="reveal">
          <span class="mono">NOTHING LOST</span>
          <h3>Every outcome, written down.</h3>
          <p>Each conversation ends with a clear record of who it was, what they needed and what happens next.</p>
        </li>
      </ol>
    </div>
    <div class="wrap">
      <p class="mono boundaries-title reveal">YOUR BOUNDARIES, BUILT IN · YOU DECIDE WHERE THEY STOP</p>
      <ul class="boundaries">
        {[
          ["Knowledge", "Your approved business facts and answers."],
          ["Identity", "Verification before customer-specific information."],
          ["Outreach", "Selected contacts, DNC checks and configured schedules."],
          ["Exceptions", "Urgent or unsupported requests go to your chosen team."],
          ["Review", "Call records, transcripts and follow-up status."],
        ].map(([t, d]) => <li class="reveal"><b>{t}</b><span>{d}</span></li>)}
      </ul>
    </div>
  </section>

  <!-- 10 · PLAIN ANSWERS -->
  <Faq eyebrow="10 · PLAIN ANSWERS" />

  <!-- FROM OUR FOUNDER (the full note and our story are on the About page) -->
  {founderLive && (
    <section class="founder-strip light" aria-label="From our founder">
      <div class="wrap founder-card reveal">
        <img src={FOUNDER.photo} alt={FOUNDER.photoAlt} width="720" height="900" loading="lazy" />
        <div>
          <p class="mono">FROM OUR FOUNDER</p>
          <blockquote>“{FOUNDER.mission}”</blockquote>
          <p class="founder-by"><b>{FOUNDER.name}</b> · {FOUNDER.title}</p>
          <a class="founder-more" href="/about/#story">Read our story <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>
  )}

  <BookDemo
    eyebrow="30 MINUTES · SYDNEY AND SAN FRANCISCO"
    line1="Put an AI professional"
    line2="on your team."
    sub="Pick a time and we’ll show you the right professional on a live call."
    agenda={[{ title: "Hear them live" }, { title: "Map the work slipping through" }, { title: "Setup and pricing" }]}
  />

  <Fragment slot="scripts">
    <script is:inline>
      // "Meet the team": each card cycles through example activity, staggered so they don't change together.
      (() => {
        if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        document.querySelectorAll("[data-live]").forEach((el, n) => {
          const items = JSON.parse(el.dataset.live || "[]");
          const text = el.querySelector(".member-live-text");
          if (items.length < 2 || !text) return;
          let i = 0;
          setTimeout(() => setInterval(() => {
            i = (i + 1) % items.length;
            text.classList.remove("is-in");
            void text.offsetWidth;
            text.textContent = items[i];
            text.classList.add("is-in");
          }, 3200), n * 1050);
        });
      })();
    </script>
  </Fragment>
</Base>
