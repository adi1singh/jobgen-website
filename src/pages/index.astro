---
import Base from '../layouts/Base.astro';
import HeroSignal from '../components/HeroSignal.astro';
import AgentIdentity from '../components/AgentIdentity.astro';
import RealRecording from '../components/RealRecording.astro';
import CostOfWaiting from '../components/CostOfWaiting.astro';
import VideoTestimonial from '../components/VideoTestimonial.astro';
import Faq from '../components/Faq.astro';
import BookDemo from '../components/BookDemo.astro';
import { WORKFORCE, LINKS, CLIENTS } from '../data/site';
import { RECORDINGS } from '../data/recordings';
const calls = [RECORDINGS.find(r => r.id === 'education-support')!, RECORDINGS.find(r => r.id === 'property-report')!];
const problems = [
 { label: 'The calls you miss', title: 'A ring. A voicemail.|A missed opportunity.', text: 'You’re with a customer. The phone rings. By the time you call back, they may have moved on.', kind: 'calls' },
 { label: 'The follow-ups that wait', title: 'Interest today.|Forgotten tomorrow.', text: 'Your database is full of conversations worth having. Your team’s day is already full.', kind: 'leads' },
 { label: 'The work that piles up', title: 'More applicants.|The same hours.', text: 'Screening every applicant takes time your recruiters could spend on the right conversations.', kind: 'hiring' },
];
const steps = [
 { title: 'Understand', text: 'Your services, your knowledge and your rules. The AI starts with what your business approves.' },
 { title: 'Take action', text: 'Answer the question. Book the appointment. Qualify the next step. Work moves forward during the conversation.' },
 { title: 'Keep it connected', text: 'Save the details and send them to your connected calendars, CRM or supported applicant tracking system.' },
 { title: 'Bring in your team', text: 'When a conversation needs a person, hand it over with context. You decide when your people take over.' },
];
const products = [
 { ...WORKFORCE[0], intro: 'A warm welcome.|Every time.', detail: 'The front desk that keeps your business open to opportunity. Jenny answers, books and hands over, even when your team is busy.', note: 'INBOUND CONVERSATIONS', audio: 'Hear Jenny', sample: '“Hi, thanks for calling. How can I help you today?”' },
 { ...WORKFORCE[1], intro: 'Your next listing|starts with hello.', detail: 'Turn the property owners already in your database into conversations. Olivia follows up, listens for selling intent and organises the next step.', note: 'PROPERTY OWNER FOLLOW-UP', audio: 'Hear Olivia', sample: '“Is a property appraisal something you’re considering?”' },
 { ...WORKFORCE[2], intro: 'A fuller picture.|A clearer shortlist.', detail: 'Give every applicant a proper first conversation. Jess screens by voice and brings structured responses back to your recruitment team.', note: 'RECRUITMENT SCREENING', audio: '', sample: 'Voice screening. Structured responses. Human decisions.' },
];
const process = [
 { title: 'Find your starting point', text: 'Tell us where calls, follow-ups or admin slow you down.' },
 { title: 'Make it yours', text: 'Our Sydney team connects your knowledge, tools and handover rules.' },
 { title: 'Try it together', text: 'Test the conversations and review the outcomes before going live.' },
 { title: 'Keep getting better', text: 'Review summaries, refine the rules and expand when you’re ready.' },
];
---
<Base title="Business on. Busywork off. | JobGen.AI" description="An AI workforce for the calls, follow-ups and everyday work that hold your business back. Meet Jenny, Olivia and Jess. Built with you in Sydney." ogImage="/og/home.png">
<noscript><style>
 .revamp-home .agent-panel[hidden]{display:grid!important}
 .revamp-home .workforce-tabs,.revamp-home .problem-navigation{display:none}
 .revamp-home .flow-step-detail{display:block;font-size:12px;line-height:1.7;margin-top:14px;color:#b8c8de}
 .revamp-home .flow-detail{display:none}
 </style></noscript>
<div class="revamp-home">
 <section class="hero flow-hero" aria-labelledby="hero-title">
  <div class="hero-atmosphere" aria-hidden="true"></div><div class="hero-art"><HeroSignal interactive /></div>
  <div class="wrap flow-hero-content">
   <p class="overline hero-overline"><span class="status-dot"></span> AI WORKFORCE. HUMAN AMBITION.</p>
   <h1 id="hero-title"><span>Business on.</span><span class="flow-title">Busywork off.</span></h1>
   <p class="flow-hero-sub">Your AI workforce answers calls, follows up leads and gets the next step done. Give your people time for the work that matters.</p>
   <div class="hero-actions"><a class="btn btn-blue" href="#book">Book a demo <span aria-hidden="true">↗</span></a><a class="text-play" href="#listen"><span class="play-ring" aria-hidden="true">▶</span> Hear a real call</a></div>
   <p class="hero-footnote">Built around your business. Set up with your team.</p>
  </div>
  <div class="hero-art-caption mono" aria-hidden="true"><span class="crosshair">+</span> INTELLIGENCE, IN MOTION.<br /><span class="caption-detail">A new rhythm for your working day.</span></div>
  <div class="wrap hero-bottom"><a class="scroll-cue mono" href="#problem"><span class="scroll-line" aria-hidden="true"></span> SCROLL TO SEE THE SHIFT</a><div class="hero-bottom-note"><span><i></i> YOUR TOOLS</span><span><i></i> YOUR RULES</span><span><i></i> YOUR NEXT MOVE</span></div></div>
 </section>
 <section class="client-line" aria-label="Some of the teams we work with"><div class="wrap client-line-inner"><p class="mono">ALREADY PART OF<br />THE WORKING DAY AT</p><div class="client-logos">{[CLIENTS[0], CLIENTS[1], CLIENTS[2], CLIENTS[3]].map(c => <img src={c.logo} alt={c.name} width={c.w} height={c.h} loading="lazy" />)}</div></div></section>
 <section class="problem-chapter paper" id="problem" aria-labelledby="problem-title">
  <div class="problem-sticky wrap"><div class="problem-copy"><p class="overline">01 / THE EVERYDAY FRICTION</p><h2 id="problem-title">The work<br /><span class="paper-muted">can’t wait.</span></h2><p class="section-intro">Customers call. Leads cool down. Applications pile up. Your team still has one working day.</p>
   <div class="problem-navigation" aria-label="Explore everyday business problems">{problems.map((p, i) => <button class={i === 0 ? 'is-active' : ''} type="button" data-problem-go={i} aria-pressed={i === 0}><span class="mono">{'0' + (i + 1)}</span>{p.label}<span aria-hidden="true">↗</span></button>)}</div><p class="problem-scroll-note mono">THREE FAMILIAR MOMENTS.<br />ONE DIFFERENT WAY FORWARD.</p></div>
   <div class="problem-scenes">{problems.map((p, i) => <article class={'problem-scene ' + (i === 0 ? 'is-active' : '')} data-problem-scene={i}>
    <div class={'friction-visual friction-' + p.kind} aria-hidden="true"><div class="friction-grid"></div>
     {p.kind === 'calls' && <><div class="phone-orbit"><span>↙</span></div><div class="missed-toast"><span class="toast-icon">↙</span><div><b>Incoming customer call</b><small>While your team is with a client</small></div><span class="missed-tag">Missed</span></div><div class="paper-task"><span class="mono">TODAY’S PRIORITIES</span><p><i></i> Client appointments</p><p><i></i> Quotes to send</p><p><i></i> Calls to return <em>Still waiting</em></p></div></>}
     {p.kind === 'leads' && <><div class="lead-stack">{[['AK','Property owner enquiry','Appraisal requested'],['JM','Existing owner contact','Follow-up due'],['SL','Database conversation','Waiting for a callback']].map(([a,b,c]) => <div><i>{a}</i><span>{b}<small>{c}</small></span><em>To call</em></div>)}</div><span class="visual-caption mono">THE INTENT IS THERE. THE TIME ISN’T.</span></>}
     {p.kind === 'hiring' && <><div class="application-stack">{['Application received','Screening to arrange','Another CV to review','Interview notes to write'].map((t,n) => <div style={'--card-order:' + n}><span class="document-icon">≡</span><span>{t}<small>Waiting for your team</small></span><span>···</span></div>)}</div><span class="visual-caption mono">A FULL INBOX. A FINITE WORKING DAY.</span></>}
    </div><div class="problem-scene-copy"><span class="mono scene-counter">{'0' + (i + 1)} / 03</span><h3>{p.title.split('|').map(line => <span>{line}</span>)}</h3><p>{p.text}</p></div>
   </article>)}<span class="illustration-note mono">ILLUSTRATIVE WORKFLOWS</span></div>
  </div>
 </section>
 <section class="solution-chapter" id="solution" aria-labelledby="solution-title"><div class="solution-light" aria-hidden="true"></div><div class="wrap"><p class="overline reveal">02 / A DIFFERENT WAY TO WORK</p><h2 class="solution-statement" id="solution-title" data-ink><span>Work moves forward.</span><br /><span>People stay in control.</span></h2><div class="solution-intro reveal"><p>Let AI take care of the repeatable work.<br />Give your people the moments that matter.</p><a class="inline-link" href="#workforce">Meet your AI workforce <span aria-hidden="true">↗</span></a></div>
  <div class="flow-steps" aria-label="How JobGen works">{steps.map((s,i) => <button type="button" class={'flow-step ' + (i === 0 ? 'is-active' : '')} aria-pressed={i === 0} data-flow-step={i}><span class="flow-node"><span class="mono">{'0' + (i + 1)}</span><svg viewBox="0 0 64 64" aria-hidden="true"><circle cx="32" cy="32" r="27"/><path d={i === 0 ? 'M22 34v-5m7 11V23m7 21V19m7 16v-7' : i === 1 ? 'M22 33l7 7 15-17' : i === 2 ? 'M20 25h24M20 32h24M20 39h24' : 'M23 42v-6a9 9 0 0118 0v6M32 19a5 5 0 110 10 5 5 0 010-10'}/></svg></span><span class="flow-step-name">{s.title}</span><span class="flow-step-detail">{s.text}</span></button>)}</div><p class="flow-detail" aria-live="polite">{steps[0].text}</p><p class="flow-smallprint mono">YOUR KNOWLEDGE → YOUR TOOLS → YOUR RULES</p>
 </div></section>
 <section class="workforce-chapter" id="workforce" aria-labelledby="workforce-title"><div class="wrap"><div class="workforce-heading"><div><p class="overline reveal">03 / MEET YOUR NEXT TEAMMATES</p><h2 id="workforce-title" class="reveal">Three specialists.<br /><span class="muted-blue">One stronger team.</span></h2></div><p class="section-intro reveal">Start with the work holding you back.<br />Meet the AI built to move it forward.</p></div>
  <div class="workforce-tabs" role="tablist" aria-label="AI workforce">{products.map((w,i) => <button type="button" id={'tab-' + w.key} role="tab" aria-selected={i === 0} aria-controls={'product-' + w.key} tabindex={i === 0 ? 0 : -1} data-agent-tab={w.key}><span class="mono">{'0' + (i + 1)}</span><span class="tab-agent-name">{w.name}</span><span class="tab-agent-role">{w.key === 'jenny' ? 'AI receptionist' : w.key === 'olivia' ? 'AI sales agent' : 'AI recruitment assistant'}</span><span class="tab-plus" aria-hidden="true">↗</span></button>)}</div>
  <div class="workforce-panels">{products.map((w,i) => <article class="agent-panel" id={'product-' + w.key} role="tabpanel" aria-labelledby={'tab-' + w.key} hidden={i !== 0}><div class="identity-stage"><span class="identity-cross cross-one" aria-hidden="true">+</span><span class="identity-cross cross-two" aria-hidden="true">+</span><AgentIdentity kind={w.key as 'jenny' | 'olivia' | 'jess'}/><p class="identity-sample">{w.sample}</p><span class="identity-note mono">{w.note}</span></div><div class="agent-panel-copy"><span class="overline agent-presence"><span class="status-dot"></span>{w.role}</span><h3>{w.intro.split('|').map(line => <span>{line}</span>)}</h3><p>{w.detail}</p><ul>{w.capabilities.map(c => <li><span aria-hidden="true">↗</span>{c}</li>)}</ul><div class="agent-actions"><a class="btn btn-blue" href={w.href}>Explore {w.name} <span aria-hidden="true">↗</span></a>{w.audio && <a class="inline-link" href={'#call-' + w.key}>{w.audio} <span aria-hidden="true">▶</span></a>}</div></div></article>)}</div>
  <div class="workforce-note"><p>Need the website, chat or a custom workflow to connect it all?</p><a href={LINKS.webDevelopment}>We build that too <span aria-hidden="true">↗</span></a></div>
 </div></section>
 <section class="listen-chapter paper" id="listen" aria-labelledby="listen-title"><div class="wrap"><div class="listen-heading"><div><p class="overline reveal">REAL CONVERSATIONS. REAL NEXT STEPS.</p><h2 id="listen-title" class="reveal">Hear the<br /><span class="paper-muted">difference.</span></h2></div><p class="section-intro reveal">Listen to Jenny and Olivia at work.<br />Real recordings, with personal details removed.</p></div><div class="home-recordings">{calls.map((rec,i) => <div id={'call-' + (i === 0 ? 'jenny' : 'olivia')}><span class="recording-persona mono">{i === 0 ? 'JENNY / RECEPTION' : 'OLIVIA / PROPERTY SALES'}</span><RealRecording rec={rec} aiLabel={i === 0 ? 'Jenny' : 'Olivia'}/></div>)}</div><div class="listen-try"><p>Or have a conversation of your own.</p><a class="btn btn-ink" href="/demo/">Try the live demo <span aria-hidden="true">↗</span></a></div></div></section>
 <section class="value-chapter paper" id="value" aria-labelledby="value-title"><div class="wrap"><p class="overline reveal">04 / ROOM FOR WHAT MATTERS</p><div class="value-heading"><h2 id="value-title" class="reveal">Less admin.<br /><span class="paper-muted">More opportunity.</span></h2><p class="section-intro reveal">For a growing business or an established team, the value starts in the everyday.</p></div><div class="value-list">{[
  ['Time for your people','Fewer routine calls and repetitive tasks between your team and the work they do best.'],
  ['A next step for every conversation','Details captured, appointments made and follow-ups organised, according to your rules.'],
  ['A setup that grows with you','Start with one workflow. Connect more as the value becomes clear. Your people stay in control.'],
 ].map(([title,text],i) => <article class="value-row reveal"><span class="mono">{'0' + (i + 1)}</span><h3>{title}</h3><p>{text}</p><span class="value-arrow" aria-hidden="true">↗</span></article>)}</div><details class="value-calculator"><summary><span class="calculator-symbol" aria-hidden="true">＋</span><span>Put your own numbers to it.<small>Explore the cost of missed opportunities and repetitive admin.</small></span><span class="calculator-toggle mono">OPEN CALCULATOR <b aria-hidden="true">↗</b></span></summary><CostOfWaiting eyebrow="YOUR BUSINESS / YOUR NUMBERS"/></details></div></section>
 <section class="customer-chapter" aria-labelledby="customer-title"><div class="wrap"><p class="overline reveal">THE PEOPLE ALREADY FEELING THE DIFFERENCE</p><h2 id="customer-title" class="reveal">The phone stopped<br /><span class="muted-blue">interrupting the work.</span></h2><VideoTestimonial/></div></section>
 <section class="setup-chapter paper" aria-labelledby="setup-title"><div class="wrap"><div class="setup-heading"><p class="overline reveal">FROM FIRST CONVERSATION TO EVERYDAY FLOW</p><h2 id="setup-title" class="reveal">Your business.<br /><span class="paper-muted">Your rules.</span></h2></div><ol class="setup-steps">{process.map((s,i) => <li class="reveal"><div class="setup-step-top"><span class="mono">{'0' + (i + 1)}</span><span aria-hidden="true">{i < 3 ? '→' : '↗'}</span></div><h3>{s.title}</h3><p>{s.text}</p></li>)}</ol></div></section>
 <Faq eyebrow="A FEW THINGS YOU MIGHT BE WONDERING"/>
 <BookDemo eyebrow="YOUR NEXT CHAPTER STARTS WITH A CONVERSATION" line1="Let’s find your flow." line2="Together." sub="In 30 minutes, we’ll look at where your business gets held up — and show you where AI can help." agenda={[{title:'Your biggest bottleneck'},{title:'The right AI, in action'},{title:'Your setup and next steps'}]} quoteFrom={null}/>
</div>
<script is:inline slot="scripts" src="/js/revamp.js" defer></script>
</Base>
