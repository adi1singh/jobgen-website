---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import FounderNote from "../components/FounderNote.astro";
import BookDemo from "../components/BookDemo.astro";
import { WORKFORCE, LINKS } from "../data/site";

// Facts and product descriptions are from https://jobgen.ai/about/ (lightly tidied).
const facts = [
  { label: "FOUNDED", value: "2024" },
  { label: "BASED IN", value: "Sydney, NSW, Australia" },
  { label: "OPERATED BY", value: "JobGen AI Pty Ltd" },
  { label: "COMPANY IDENTIFIERS", value: "ABN 71 696 826 561 · ACN 696 826 561" },
];
const audiences: Record<string, string> = {
  jenny: "BUSINESSES THAT RECEIVE CUSTOMER CALLS",
  olivia: "REAL ESTATE AGENCIES",
  jess: "RECRUITERS AND STAFFING TEAMS",
};
---
<Base
  title="About JobGen.AI | An Australian AI workforce platform"
  description="JobGen.AI is an Australian AI software platform for job searching, recruitment and AI-powered business assistants. Founded in 2024 and based in Sydney."
  ogTitle="About JOBGEN.AI: an Australian AI workforce platform."
  ogDescription="Founded in Sydney in 2024. Started as an AI job-search assistant, now an AI workforce for businesses."
  ogImage="/og/home.png"
  ogImageAlt="JOBGEN.AI: Grow your business with an AI workforce."
>
  <PageHero
    eyebrow="ABOUT JOBGEN.AI"
    sub="JobGen.AI is an Australian AI software platform for job searching, recruitment and AI-powered business assistants."
    secondary={{ label: "Our story ↓", href: "#story" }}
  >
    <span class="h1-line">An Australian</span>
    <span class="h1-line h1-muted">AI workforce platform.</span>
  </PageHero>

  <!-- 01 · THE COMPANY -->
  <section class="chapter about-facts light" aria-labelledby="company-title">
    <div class="wrap">
      <div class="section-head">
        <p class="mono chapter-no reveal">01 · THE COMPANY</p>
        <h2 id="company-title" class="reveal">Built in Sydney.<br /><span class="muted">With an office in San Francisco.</span></h2>
        <p class="section-sub reveal">
          Founded in 2024 and based in Sydney, JobGen.AI began as an AI job-search assistant and has grown into a
          broader AI workforce platform for candidates and businesses.
        </p>
      </div>
      <dl class="facts reveal">
        {facts.map((f) => (
          <div><dt class="mono">{f.label}</dt><dd>{f.value}</dd></div>
        ))}
        <div class="facts-wide">
          <dt class="mono">RECOGNITION</dt>
          <dd>
            Global Excellence Award, AIMBIG Oceania 2026. A member of the Antler AU15 cohort, UNSW Founders, NVIDIA
            Inception and Google for Startups. <a class="facts-source" href="/news/australia-job-market-2026/">Source: our July 2026 press release</a>
          </dd>
        </div>
        <div class="facts-wide">
          <dt class="mono">OFFICES</dt>
          <dd>Sydney · Suite 306, 60 Martin Place, NSW 2000<br />San Francisco · 580 California St, CA 94104</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- 02 · OUR STORY + FOUNDER -->
  <section class="chapter story" id="story" aria-labelledby="story-title">
    <div class="wrap">
      <div class="section-head">
        <p class="mono chapter-no reveal">02 · OUR STORY</p>
        <h2 id="story-title" class="reveal">Started with job seekers.<br /><span class="grad">Grew into an AI workforce.</span></h2>
      </div>
      <ol class="timeline">
        <li class="reveal">
          <span class="mono">2024 · SYDNEY</span>
          <h3>JobGen.AI begins</h3>
          <p>Founded in Sydney as an AI job-search assistant, helping candidates find and land roles.</p>
        </li>
        <li class="reveal">
          <span class="mono">TODAY · FOR JOB SEEKERS</span>
          <h3>Still helping people find work</h3>
          <p>Emma, our AI job-search assistant, has her own home at <a href={LINKS.jobSeekers}>candidates.jobgen.ai</a>.</p>
        </li>
        <li class="reveal">
          <span class="mono">TODAY · FOR BUSINESSES</span>
          <h3>An AI workforce</h3>
          <p>Jenny answers calls, Olivia follows up property owners and Jess screens candidates, with a web team building sites alongside. Offices in Sydney and San Francisco.</p>
        </li>
      </ol>
      <FounderNote />
    </div>
  </section>

  <!-- 03 · FOUR SPECIALISTS -->
  <section class="chapter about-products light" aria-labelledby="products-title">
    <div class="wrap">
      <div class="section-head">
        <p class="mono chapter-no reveal">03 · OUR PRODUCTS</p>
        <h2 id="products-title" class="reveal">Four specialists,<br /><span class="muted">two audiences.</span></h2>
        <p class="section-sub reveal">
          Role-specific assistants rather than one general-purpose chatbot. Each one transfers, takes a message or
          arranges a callback when a person is needed.
        </p>
      </div>
      <div class="about-grid">
        {WORKFORCE.map((w) => (
          <a class="about-card reveal" href={w.href} style={`--tint: ${w.tint}`}>
            <span class="mono">{audiences[w.key]}</span>
            <h3>{w.name} · {w.role}</h3>
            <p>{w.summary}</p>
            <span class="about-more">Learn about {w.name} <span aria-hidden="true">→</span></span>
          </a>
        ))}
        <a class="about-card reveal" href={LINKS.jobSeekers} style="--tint: var(--rest)">
          <span class="mono">JOB SEEKERS</span>
          <h3>Emma · AI job search assistant</h3>
          <p>Helps job seekers find and evaluate roles, tailor resumes, track applications, prepare for interviews and analyse ATS and keyword alignment.</p>
          <span class="about-more">Visit candidates.jobgen.ai <span aria-hidden="true">↗</span></span>
        </a>
      </div>
    </div>
  </section>


  <section class="chapter about-core light" aria-labelledby="core-title"><div class="wrap">
    <div class="section-head"><p class="mono chapter-no reveal">OUR STORY / THE NEXT CHAPTER</p><h2 id="core-title" class="reveal">From missed calls<br /><span class="muted">to work that moves.</span></h2><p class="section-sub reveal">A call should become a useful next step. JobGen connects natural conversation to bookings, customer information and the people who need to act.</p></div>
    <div class="about-core-grid"><div class="about-core-copy"><p>For service businesses, healthcare providers, legal practices and real estate agencies, the first conversation often arrives while the team is already busy. Phone trees, voicemail and a list of callbacks add more friction.</p><p>We built JobGen to bring the conversation and the workflow together: approved answers, appointment rules, pricing information and warm transfers, connected to the tools your team uses.</p><ul><li>Natural speech, with room for a real conversation</li><li>Business knowledge, access rules and escalation boundaries</li><li>A connected trail through your CRM and calendars</li></ul></div><aside class="about-core-card"><p class="mono">THE JOBGEN AI CORE</p><h3>Two agents.<br />A connected engine.</h3><a href="/receptionist/"><b>Jenny / Inbound reception</b><span>24/7 call triage, calendar booking, FAQs and warm transfer.</span><i aria-hidden="true">↗</i></a><a href="/olivia/"><b>Olivia / Sales outreach</b><span>Proactive follow-up, lead reactivation and pipeline qualification.</span><i aria-hidden="true">↗</i></a><p class="about-core-tags">WebRTC telephony · Speech recognition & synthesis · CRM telemetry · WhatsApp dispatch</p></aside></div>
  </div></section>
  <section class="chapter about-global" aria-labelledby="global-title"><div class="wrap"><div class="section-head"><p class="mono chapter-no reveal">GLOBAL FOOTPRINT</p><h2 id="global-title" class="reveal">Engineered globally.<br /><span class="muted">Operating locally.</span></h2></div><div class="about-global-grid"><article><span class="mono">01 / ASIA-PACIFIC</span><h3>Sydney headquarters</h3><p>Suite 306, 60 Martin Place<br />Sydney NSW 2000, Australia</p><p>Asia-Pacific operations & core research</p><a href="tel:+61288147905">(02) 8814 7905 ↗</a></article><article><span class="mono">02 / NORTH AMERICA</span><h3>San Francisco hub</h3><p>580 California St<br />San Francisco CA 94104, USA</p><p>North American enterprise & telephony cloud</p><a href="tel:+18005624361">+1 (800) 562-4361 ↗</a></article></div></div></section>
  <section class="chapter about-philosophy light" aria-labelledby="philosophy-title"><div class="wrap"><div class="section-head"><p class="mono chapter-no reveal">OUR PHILOSOPHY</p><h2 id="philosophy-title" class="reveal">Principles that shape<br /><span class="muted">every deployment.</span></h2></div><div class="about-principles"><article><span class="mono">01</span><h3>Speed as a feature.</h3><p>Reduce the delay across speech recognition, reasoning and audio generation so conversations keep their rhythm.</p></article><article><span class="mono">02</span><h3>Security in the workflow.</h3><p>Define data access, recording consent, retention and audit requirements as part of your setup. Confirm the controls your organisation needs with our team.</p><a href="/#platform-controls">Explore platform controls ↗</a></article><article><span class="mono">03</span><h3>People in the loop.</h3><p>Give staff time back from repeatable intake. Use warm transfers and clear escalation rules when a person’s judgement or empathy is needed.</p></article></div></div></section>

  <BookDemo
    eyebrow="30 MINUTES · SYDNEY AND SAN FRANCISCO"
    line1="Put an AI professional"
    line2="on your team."
    sub="Pick a time and we’ll show you the right professional on a live call."
    agenda={[{ title: "Hear them live" }, { title: "Map the work slipping through" }, { title: "Setup and pricing" }]}
  />
</Base>
