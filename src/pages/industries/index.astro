---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import BookDemo from "../../components/BookDemo.astro";
import { INDUSTRIES } from "../../data/industries";
import { WORKFORCE } from "../../data/site";
const name = (key: string) => WORKFORCE.find((w) => w.key === key)!.name;
---
<Base
  title="Industries | JOBGEN.AI"
  description="How Jenny and Olivia handle calls for property, plumbing, electricians, accounting, medical and dental clinics, law firms, automotive and home services."
  ogTitle="Your AI workforce, set up for your industry. JOBGEN.AI"
  ogDescription="Industry-specific questions, human handoff and full call context."
  ogImage="/og/home.png"
  ogImageAlt="JOBGEN.AI: Grow your business with an AI workforce."
>
  <PageHero
    eyebrow="INDUSTRIES"
    sub="Industry-specific questions, a human handoff when it matters, and the full context of every call for your team."
    secondary={{ label: "See industries ↓", href: "#industries" }}
  >
    <span class="h1-line">Set up for</span>
    <span class="h1-line h1-muted">the way you work.</span>
  </PageHero>
  <section class="chapter light" id="industries" aria-labelledby="ind-title">
    <div class="wrap">
      <div class="section-head">
        <p class="mono chapter-no reveal">PICK YOUR INDUSTRY</p>
        <h2 id="ind-title" class="reveal">Eight industries,<br /><span class="muted">one standard for every call.</span></h2>
      </div>
      <ul class="ind-index">
        {INDUSTRIES.map((i) => (
          <li class="reveal">
            <a href={`/industries/${i.slug}/`} style={`--tint: ${i.agent === "olivia" ? "var(--prop)" : "var(--edu)"}`}>
              {i.image ? <img src={i.image} alt="" width="1400" height="932" loading="lazy" /> : <span class="ind-index-art" aria-hidden="true"></span>}
              <span class="ind-index-body">
                <span class="mono">{i.label}</span>
                <strong>{i.headline}</strong>
                <span class="picker-who"><span class="dot"></span>{name(i.agent)}<span class="arrow" aria-hidden="true">→</span></span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <BookDemo
    line1="Bring us a real"
    line2="enquiry from your business."
    sub="Pick a time and we’ll run it with Jenny or Olivia, live."
    agenda={[{ title: "Hear them live" }, { title: "Map your calls and handovers" }, { title: "Setup and pricing" }]}
  />
</Base>
