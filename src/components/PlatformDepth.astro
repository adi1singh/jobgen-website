---
import { INTEGRATIONS } from '../data/faq';
const groups = [
 { id:'conversations',no:'01',title:'Every conversation, covered.',sub:'Inbound, outbound and everything that follows.',items:[['Answer around the clock','A business-name greeting, approved answers, messages and after-hours or overflow coverage. Keep your existing number with call forwarding.'],['Follow up with purpose','Reach eligible contacts on your schedule, qualify their interest and organise an owned next step. Respect your contact rules and preferences.'],['Meet customers where they are','Bring phone, website chat, browser voice and WhatsApp into connected customer workflows.'],['Make the human handover count','Transfer an urgent or high-value conversation when your team is available, or collect a clear message and callback context.']] },
 { id:'appointments',no:'02',title:'From a call to a confirmed plan.',sub:'Calendars, messages and documents working together.',items:[['Check real availability','Use connected Outlook, Google Calendar or Calendly availability, with appointment length, buffer and staff rules.'],['Book, change and confirm','Arrange appointments, reschedule, cancel and send confirmations during the customer journey.'],['Send the useful details','Follow up through configured SMS or WhatsApp workflows with confirmations, brochures, checklists, intake forms and location links.'],['Keep the work organised','Capture contact details, customer intent, summaries and follow-up tasks in the connected CRM or supported ATS.']] },
 { id:'visibility',no:'03',title:'Every detail has somewhere to go.',sub:'A visible trail from first contact to your team.',items:[['Review the conversation','Search transcripts, listen to recordings and review summaries, caller sentiment tags and captured details in the configured workflow.'],['Keep systems in step','Bring confirmed bookings, customer notes and follow-up actions into the tools your team already uses.'],['Support the next task','Connect document intake, email scanning and workflow monitoring to the agreed business process.'],['Compare the difference','Replace voicemail, manual note-taking, scattered tabs and forgotten follow-ups with one connected chain of actions.']] },
 { id:'platform-controls',no:'04',title:'Your business. Your boundaries.',sub:'Knowledge, identity and escalation rules are part of the setup.',items:[['Start with approved knowledge','Provide service menus, documents, pricing policies, hours or listings. Set the answers the AI can give and the fallback when it cannot.'],['Capture the right information','Choose required intake fields and qualification questions. Set identity checks before customer-specific information is shared.'],['Define when people take over','Configure urgent and VIP escalation, staff availability, transfer or callback rules and the context your team receives.'],['Test before going live','Try conversations in the browser, review audio and system entries, then connect your number. Preserve recording consent and the required audit trail.']] },
];
---
<section class="platform-depth" id="platform" aria-labelledby="platform-title">
 <div class="wrap"><p class="overline reveal">THE WHOLE WORKFLOW. NOT JUST THE VOICE.</p><div class="depth-heading"><h2 id="platform-title" class="reveal">Built to finish<br /><span class="muted-blue">the job.</span></h2><p class="section-intro reveal">A useful answer is the start.<br />A completed next step is the point.</p></div>
 <div class="capability-groups">{groups.map((g,i)=><details id={g.id} class="capability-group" open={i===0}><summary><span class="mono">{g.no}</span><span><b>{g.title}</b><small>{g.sub}</small></span><span class="capability-plus" aria-hidden="true">+</span></summary><dl>{g.items.map(([title,text])=><div><dt>{title}</dt><dd>{text}</dd></div>)}</dl></details>)}</div>
 <div class="integration-depth" id="integrations"><p class="overline">WORKS WITH YOUR WORKING DAY</p><h3>Your tools. Connected.</h3><div class="integration-names" aria-label="Integration tools">{INTEGRATIONS.map(name=><span>{name}</span>)}</div><p class="integration-note">Connections, channels and handover behaviour are configured for your business. We’ll map the right setup with you.</p><a class="inline-link" href="#book">Map your workflow with us <span aria-hidden="true">↗</span></a></div>
 </div>
</section>
