---
// How it works: the three setup steps and the tools it connects to, word for word from
// sales.jobgen.ai ("Start with one call flow. Keep control as you grow.").
import { INTEGRATIONS } from "../data/faq";
import { LINKS } from "../data/site";
interface Props {
  eyebrow?: string;
}
const { eyebrow = "HOW IT WORKS" } = Astro.props;
const steps = [
  { title: "Give her the facts you already use.", text: "Services, opening hours, course information or property details. Add approved answers and the questions your team cannot answer without a person.", tags: "Business information · Approved answers" },
  { title: "Decide what a complete enquiry needs.", text: "A property address and selling timeframe. A student number. A booking preference. Set the details to capture and the situations to escalate.", tags: "Required details · Escalation rules" },
  { title: "Test the call. Then hand over with context.", text: "Try your own scenarios before routing calls. Review the transcript, request and next step, so the person following up knows where to begin.", tags: "Test calls · Transcripts · Follow-up owner" },
];
---
<section class="chapter how-it-works" id="how-it-works" aria-labelledby="how-title">
  <div class="wrap">
    <div class="section-head">
      <p class="mono chapter-no reveal">{eyebrow}</p>
      <h2 id="how-title" class="reveal">Start with one call flow.<br /><span class="grad">Keep control as you grow.</span></h2>
      <p class="section-sub reveal">Set up the information, questions and boundaries for your first use case. Test it with your team before routing calls or launching a campaign.</p>
    </div>
    <ol class="how-steps">
      {steps.map((s, i) => (
        <li class="reveal" style={`transition-delay: ${i * 80}ms`}>
          <span class="how-no">{String(i + 1).padStart(2, "0")}</span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
          <span class="mono how-tags">{s.tags}</span>
        </li>
      ))}
    </ol>
    <div class="integrations reveal">
      <div class="integrations-head">
        <p class="mono">CONNECTS TO THE TOOLS YOU USE</p>
        <p class="integrations-note">Channels, CRM connections and live transfers depend on your setup.</p>
      </div>
      <ul class="integration-list">
        {INTEGRATIONS.map((n) => <li>{n}</li>)}
      </ul>
    </div>
    <div class="how-cta reveal">
      <a class="btn btn-light" href="#book">Book a demo <span aria-hidden="true">→</span></a>
      <a class="btn btn-ghost" href={LINKS.startFree}>Start free</a>
      <span class="how-cta-note">No card required · Human handoff built in</span>
    </div>
  </div>
</section>
