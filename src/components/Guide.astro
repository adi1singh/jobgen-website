---
// "Not sure which one you need?": a short guide in the corner. Four quick questions about the business
// (not about our products), then a suggested starting point with the reason for each piece.
// Scripted, not an AI chat, and nothing is sent anywhere.
import { WORKFORCE, LINKS } from "../data/site";
interface Props {
  bookHref?: string;
}
const { bookHref = "#book" } = Astro.props;
// The questions, in order. The last one changes with the kind of business.
const steps = [
  {
    id: "type",
    q: "First, what kind of business do you run?",
    options: [["realestate", "Real estate agency"], ["recruit", "Recruitment or staffing"], ["service", "Clinic, trades or local services"], ["other", "Something else"]],
  },
  {
    id: "leak",
    q: "Where are you losing the most right now?",
    options: [["calls", "Calls we miss or answer late"], ["followup", "Leads nobody follows up"], ["admin", "Admin eating our team’s time"], ["enquiries", "Not enough enquiries coming in"]],
  },
  {
    id: "channel",
    q: "How do most new customers reach you?",
    options: [["phone", "They call us"], ["online", "Online, through our website or forms"], ["both", "A bit of both"]],
  },
  {
    id: "list",
    q: {
      realestate: "Are there property owners in your database nobody has spoken to in a while?",
      recruit: "Do you get more applicants than your team can screen?",
      other: "Do you have past enquiries or customers nobody has followed up?",
    },
    options: [["yes", "Yes"], ["no", "No"]],
  },
];
// Everything the guide can suggest: the three professionals, plus the rest of the workforce.
const people = {
  ...Object.fromEntries(WORKFORCE.map((w) => [w.key, { name: w.name, role: w.role, href: w.href, tint: w.tint, cta: `Meet ${w.name}` }])),
  website: { name: "AI-ready website", role: "The front door, built to convert", href: LINKS.webDevelopment, tint: "var(--rest)", cta: "See web development" },
  crm: { name: "CRM with SMS and email", role: "Automated follow-up", href: "/#solution", tint: "#b48cff", cta: "See how it fits" },
  magnets: { name: "Lead magnets and offers", role: "Visitors into captured leads", href: "/#solution", tint: "var(--trade)", cta: "See how it fits" },
};
---
<div class="guide in-hero" data-guide>
  <button type="button" class="guide-launch" aria-expanded="false" aria-controls="guide-panel" data-guide-open>
    <span class="guide-orb" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="guide-launch-long">Not sure which one you need?</span>
    <span class="guide-launch-short">Which one do I need?</span>
  </button>

  <section class="guide-panel" id="guide-panel" role="dialog" aria-labelledby="guide-title" tabindex="-1" hidden>
    <header class="guide-head">
      <span class="guide-orb" aria-hidden="true"><i></i><i></i><i></i></span>
      <div>
        <h2 id="guide-title">Find your fit</h2>
        <p>4 quick questions · nothing is sent</p>
      </div>
      <button type="button" class="guide-close" aria-label="Close the guide" data-guide-close>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
    </header>
    <div class="guide-log" data-guide-log aria-live="polite"></div>
    <div class="guide-answers" data-guide-answers role="group" aria-label="Your answer"></div>
    <noscript><p class="guide-noscript">Meet <a href="/receptionist/">Jenny</a>, <a href="/olivia/">Olivia</a> or <a href="/recruiter-agent/">Jess</a>.</p></noscript>
  </section>

  <script type="application/json" data-guide-data set:html={JSON.stringify({ steps, people, book: bookHref, calendly: LINKS.calendly })} />
</div>

<script is:inline>
  (() => {
    const root = document.querySelector("[data-guide]");
    if (!root) return;
    const { steps, people, book, calendly } = JSON.parse(root.querySelector("[data-guide-data]").textContent);
    const launch = root.querySelector("[data-guide-open]");
    const panel = root.querySelector(".guide-panel");
    const log = root.querySelector("[data-guide-log]");
    const answers = root.querySelector("[data-guide-answers]");
    const still = matchMedia("(prefers-reduced-motion: reduce)");
    // "#book" only works where the page has a calendar; elsewhere go straight to Calendly.
    const bookUrl = book.startsWith("#") && !document.querySelector(book) ? calendly : book;
    let a = {};
    let run = 0;

    const el = (tag, cls, html) => {
      const n = document.createElement(tag);
      if (cls) n.className = cls;
      if (html !== undefined) n.innerHTML = html;
      return n;
    };
    const scroll = () => (log.scrollTop = log.scrollHeight);
    // The guide "types" briefly before each message, unless motion is reduced.
    const say = async (html, id) => {
      if (!still.matches) {
        const dots = el("p", "guide-msg guide-typing", "<i></i><i></i><i></i>");
        dots.setAttribute("aria-hidden", "true");
        log.append(dots);
        scroll();
        await new Promise((r) => setTimeout(r, 550));
        dots.remove();
      }
      if (id !== run) return false;
      log.append(el("p", "guide-msg", html));
      scroll();
      return true;
    };
    const offer = (choices) => {
      answers.innerHTML = "";
      choices.forEach(([label, fn], i) => {
        const b = el("button", "guide-answer", label);
        b.type = "button";
        b.addEventListener("click", fn);
        answers.append(b);
        if (i === 0) b.focus({ preventScroll: true });
      });
    };
    const reply = (label) => {
      answers.innerHTML = "";
      log.append(el("p", "guide-msg guide-me", label));
      scroll();
    };

    const ask = async (i, id) => {
      const step = steps[i];
      const q = typeof step.q === "string" ? step.q : step.q[a.type] || step.q.other;
      if (!(await say(q, id))) return;
      offer(
        step.options.map(([value, label]) => [
          label,
          () => {
            reply(label);
            a[step.id] = value;
            if (i + 1 < steps.length) ask(i + 1, id);
            else result(id);
          },
        ]),
      );
      answers.classList.toggle("is-list", step.options.length > 2);
    };

    // What to start with, and why, from the answers. First item is the main suggestion.
    const suggest = () => {
      const out = [];
      const add = (key, why) => out.some(([k]) => k === key) || out.push([key, why]);
      const phone = a.channel !== "online";
      if (a.type === "recruit") add("jess", a.list === "yes" ? "You get more applicants than your team can screen. Jess can call and screen the ones your team doesn’t reach." : "Jess screens applicants by phone and writes the results to your ATS.");
      if (a.type === "realestate" && (a.list === "yes" || a.leak === "followup")) add("olivia", a.list === "yes" ? "Owners in your database haven’t heard from you in a while. Olivia calls them." : "Leads aren’t being followed up. Olivia calls owners and books appraisals.");
      if (a.leak === "calls") add("jenny", "Calls are being missed or answered late. Jenny handles calls around the clock and passes on what needs a person.");
      if (a.leak === "admin") add("jenny", "Jenny takes bookings, reception and messages off your team.");
      if (a.leak === "enquiries") add("website", "You need more enquiries. A website built to convert brings them in.");
      if (a.leak === "followup") add("crm", "Automated SMS and email follow-up for the enquiries you choose.");
      if (a.type !== "realestate" && a.type !== "recruit" && a.list === "yes") add("crm", "Old enquiries get a follow-up campaign instead of sitting in a list.");
      if (a.leak === "enquiries") add("magnets", a.type === "realestate" ? "Offers like property evaluation reports turn visitors into leads." : "Offers like guides and referral campaigns turn visitors into leads.");
      if (phone) add("jenny", "Customers ring you, so Jenny can handle calls around the clock, with handover when needed.");
      if (a.channel === "online") add("website", "Customers find you online, so your website does the first job.");
      if (a.type === "realestate") add("olivia", "She calls owners already in your database and books appraisals.");
      return out.slice(0, 3);
    };

    const card = ([key, why], main) => {
      const p = people[key];
      return (
        `<a class="guide-card${main ? " is-main" : ""}" href="${p.href}" style="--tint: ${p.tint}">` +
        `<b>${p.name}</b><small>${p.role}</small><span class="guide-why">${why}</span>` +
        `<em>${p.cta} <span aria-hidden="true">→</span></em></a>`
      );
    };

    const result = async (id) => {
      const fit = suggest();
      if (!(await say(`Here’s where I’d start: <b>${people[fit[0][0]].name}</b>.`, id))) return;
      log.append(el("div", "guide-cards", card(fit[0], true)));
      if (fit.length > 1) {
        log.append(el("p", "guide-msg", "Then add:"));
        log.append(el("div", "guide-cards", fit.slice(1).map((f) => card(f, false)).join("")));
      }
      log.append(el("p", "guide-msg guide-note", "A starting point, not a quote. We’ll shape it around your business on a 30-minute demo."));
      scroll();
      answers.classList.remove("is-list");
      answers.innerHTML = "";
      const bookLink = el("a", "btn btn-light btn-small guide-book", `Book a demo <span aria-hidden="true">→</span>`);
      bookLink.href = bookUrl;
      if (bookUrl.startsWith("http")) {
        bookLink.target = "_blank";
        bookLink.rel = "noopener";
      }
      bookLink.addEventListener("click", () => bookUrl.startsWith("#") && close(false));
      const again = el("button", "guide-answer guide-again", "Start over");
      again.type = "button";
      again.addEventListener("click", start);
      answers.append(bookLink, again);
      (answers.querySelector(".guide-book") || again).focus({ preventScroll: true });
      // Keyboard users can reach the cards from the answers too.
      log.querySelectorAll(".guide-card").forEach((link) => link.addEventListener("click", () => close(false)));
    };

    function start() {
      run++;
      a = {};
      log.innerHTML = "";
      answers.innerHTML = "";
      const id = run;
      say("Hi! Four quick questions about your business and I’ll suggest where to start.", id).then(
        (ok) => ok && ask(0, id),
      );
    }
    let opener = null;
    function open() {
      panel.hidden = false;
      launch.setAttribute("aria-expanded", "true");
      alts.forEach((b) => b.hasAttribute("aria-controls") && b.setAttribute("aria-expanded", "true"));
      root.classList.add("is-open");
      if (!log.children.length) {
        panel.focus({ preventScroll: true });
        start();
      } else (answers.querySelector("button, a") || panel.querySelector("[data-guide-close]")).focus({ preventScroll: true });
    }
    function close(returnFocus = true) {
      panel.hidden = true;
      launch.setAttribute("aria-expanded", "false");
      alts.forEach((b) => b.hasAttribute("aria-controls") && b.setAttribute("aria-expanded", "false"));
      root.classList.remove("is-open");
      // Focus goes back to whatever opened it (the corner button may be hidden on phones).
      const back = opener && opener.offsetParent !== null ? opener : launch.offsetParent !== null ? launch : null;
      if (returnFocus && back) back.focus({ preventScroll: true });
      opener = null;
    }

    launch.addEventListener("click", () => {
      opener = launch;
      panel.hidden ? open() : close();
    });
    // Other ways in: the phone booking bar's guide button, and "Not sure where to start?" on the home page.
    const alts = [...document.querySelectorAll("[data-guide-open-alt]")];
    alts.forEach((b) =>
      b.addEventListener("click", () => {
        opener = b;
        if (panel.hidden) open();
        else close();
      }),
    );
    root.querySelector("[data-guide-close]").addEventListener("click", () => close());
    panel.addEventListener("keydown", (e) => e.key === "Escape" && close());

    // Out of the way while the booking calendar is on screen (unless it's open).
    const hero = document.querySelector(".hero");
    if (hero) new IntersectionObserver(([e]) => root.classList.toggle("in-hero", e.isIntersecting), { threshold: 0.35 }).observe(hero);
    const cal = document.getElementById("book");
    if (cal) new IntersectionObserver(([e]) => root.classList.toggle("near-book", e.isIntersecting), { threshold: 0.15 }).observe(cal);
  })();
</script>
