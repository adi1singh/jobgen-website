---
import { FOUNDER } from '../data/founder';
---
<figure class="founder reveal" id="founder">
  <div class="founder-photo"><img src={FOUNDER.photo} alt={FOUNDER.photoAlt} width="720" height="900" loading="lazy" /></div>
  <div class="founder-body">
    <p class="mono">MEET OUR FOUNDER</p>
    <h3>Building AI that gives businesses more time for their customers.</h3>
    <p class="founder-bio">Kush leads JobGen.AI with a simple goal: help businesses respond to enquiries, follow up with customers and keep everyday work moving.</p>
    <figcaption><b>{FOUNDER.name}</b><span>{FOUNDER.title}</span></figcaption>
    <address class="founder-contacts" aria-label="Contact Kushagra Bhatia"><a href="tel:+61433506034">+61 433 506 034 ↗</a><a href="mailto:kush@jobgen.ai">kush@jobgen.ai ↗</a><a href={FOUNDER.linkedin} target="_blank" rel="noopener">LinkedIn ↗<span class="sr-only"> (opens in a new tab)</span></a></address>
  </div>
</figure>
