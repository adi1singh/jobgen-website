---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogImageAlt?: string;
  /** Where the header's "Book a demo" goes (defaults to the page's own #book section). */
  bookHref?: string;
  /** Text in the phone booking bar that appears after the hero. */
  bookBarText?: string;
  // Colours the page in one professional's palette (hero light, headline, accents).
  persona?: "jenny" | "olivia" | "jess";
  /** Keep this page out of search results (e.g. the 404 page). */
  noindex?: boolean;
}
const {
  title,
  description,
  ogTitle = title,
  ogDescription = description,
  ogImage = "/og/jenny.png",
  ogImageAlt = title,
  bookHref = "#book",
  bookBarText = "See your AI workforce in 30 minutes",
  persona,
  noindex = false,
} = Astro.props;
// Same-site pages are fetched ahead when a visitor hovers or presses a link (Chrome's speculation rules).
const speculation = {
  prefetch: [{ where: { and: [{ href_matches: "/*" }, { not: { selector_matches: "[target=_blank], [download], [data-live-demo]" } }] }, eagerness: "moderate" }],
};
// Who we are, for search engines and link previews (facts from jobgen.ai/about).
const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "JobGen.AI",
  legalName: "JobGen AI Pty Ltd",
  url: "https://jobgen.ai/",
  logo: "https://jobgen.ai/icons/icon-512.png",
  foundingDate: "2024",
  founder: { "@type": "Person", name: "Kushagra (Kush) Bhatia" },
  sameAs: ["https://www.linkedin.com/company/jobgenai/"],
  address: { "@type": "PostalAddress", streetAddress: "60 Martin Place", addressLocality: "Sydney", addressRegion: "NSW", postalCode: "2000", addressCountry: "AU" },
  email: "hello@jobgen.ai",
};
const canonical = new URL(Astro.url.pathname, Astro.site);
const image = new URL(ogImage, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#0b0b0d" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="JOBGEN.AI · AI workforce" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={image} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/icons/icon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icons/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <!-- Without JavaScript, nothing waits for a scroll animation to appear -->
    <noscript><style>.reveal { opacity: 1 !important; transform: none !important; }</style></noscript>
    <script type="application/ld+json" set:html={JSON.stringify(organization)} />
    <script type="speculationrules" set:html={JSON.stringify(speculation)} />
    <slot name="head" />
    <link rel="preload" href="/fonts/geist.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/styles/site.css" />
    <link rel="stylesheet" href="/styles/layout.css" />
  </head>
  <body data-persona={persona}>
    <div class="scroll-progress" aria-hidden="true"></div>
    <a class="skip" href="#main">Skip to content</a>
    <Header bookHref={bookHref} />
    <main id="main">
      <slot />
    </main>
    <!-- Phones: booking is one tap away once the hero is out of view -->
    <div class="book-bar" id="book-bar" hidden>
      <span>{bookBarText}</span>
      <a class="btn btn-light btn-small" href={bookHref}>Book a demo</a>
    </div>
    <Footer />
    <slot name="scripts" />
    <script is:inline src="/js/app.js"></script>
    <script is:inline src="/js/live-demo.js" defer></script>
  </body>
</html>
